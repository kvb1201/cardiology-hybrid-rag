# =============================================================================
# .gitignore — cardiology-hybrid-rag
# =============================================================================

# Python virtual environment
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Jupyter checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Environment / secrets
.env
.env.*
*.pem
*.key

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Project-specific: large binary / generated assets — do NOT commit these
# ---------------------------------------------------------------------------

# Raw and processed corpus data (may contain licensed content)
data/raw/*
data/processed/*
data/chunks/*
data/evaluation/*

# Keep directory structure but ignore contents
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/chunks/.gitkeep
!data/evaluation/.gitkeep

# Built indexes (large binary files)
indexes/bm25/*
indexes/lsh/*
indexes/faiss/*
!indexes/bm25/.gitkeep
!indexes/lsh/.gitkeep
!indexes/faiss/.gitkeep

# Experiment results (generated at runtime)
experiments/results/*
!experiments/results/.gitkeep

# Model weights / HuggingFace cache
*.bin
*.pt
*.ckpt
*.safetensors
models/
.cache/

# Logs
*.log
logs/
